{
  "name": "famdesk-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local agent.mjs start",
    "ask-help": "node --env-file=.env.local ask-help.mjs",
    "check": "node --check agent.mjs && node --check face.mjs && node --check greet.mjs && node --check image.mjs && node --check camera.mjs && node --check brain.mjs && node --check imessage.mjs && node --check ask-help.mjs",
    "test:picture": "node test-picture.mjs",
    "help": "node agent.mjs --help"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "@trychert/sdk": "0.1.0",
    "jpeg-js": "^0.4.4",
    "zod": "^4.1.8"
  }
}
