# Copy to .env.local (cp .env.example .env.local && chmod 600 .env.local), then fill in.
# Never commit .env.local.

# --- LiveKit Cloud (all three from the SAME project: cloud.livekit.io > Settings > API keys) ---
# Speech-to-text, text-to-speech and (if no Nebius key) the LLM run on LiveKit Inference,
# billed to this project's free credits.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# --- Chert: a name no other team uses ---
AGENT_NAME=siya-techhelp

# --- Nebius Token Factory ($100 hackathon credits): the agent's LLM + vision ---
# Check both model names exist in your Nebius model list. The chat model must support
# tool/function calling; the vision model must accept images.
# Without NEBIUS_API_KEY: the LLM uses LiveKit Inference and vision uses fake answers.
NEBIUS_API_KEY=
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Keenable web search (code BETA200 for $200 credits). Format: keen_... ---
KEENABLE_API_KEY=

# --- iMessage via Chert (optional; from the Chert dashboard > Developer) ---
CHERT_BASE_URL=
CHERT_API_KEY=
FAMILY_NAME=Siya
FAMILY_PHONE=
AGENT_LINE_NUMBER=

# --- Optional overrides for LiveKit Inference models ---
# LIVEKIT_STT=deepgram/flux-general-en   (or deepgram/nova-3:en)
# LIVEKIT_TTS=cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# LIVEKIT_LLM=openai/gpt-4.1-mini
